# Firebase Admin credentials — server-only. Never expose these to the browser.
# No NEXT_PUBLIC_* variants allowed; CI greps for NEXT_PUBLIC_FIREBASE.

# base64-encoded service-account JSON. Generate with:
#   base64 -w 0 path/to/service-account.json    (Linux)
#   base64 -i path/to/service-account.json      (macOS)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase project id. For this repo: parkingapp-f4edc
FIREBASE_PROJECT_ID=parkingapp-f4edc
